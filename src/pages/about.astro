---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '关于我们',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="关于我们"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: '威拓星耀团队',
    }}
  >
    <Fragment slot="title">
      助力中国品牌 <br />
      <span class="text-accent dark:text-white">闪耀全球市场</span>
    </Fragment>

    <Fragment slot="subtitle">
      威拓星耀（Vectoflare）是一家专注于外贸品牌出海的综合服务商。我们为国内制造企业和贸易公司提供从品牌独立站建设、GEO搜索引擎优化、客户数据库搭建到自动化获客工具定制的一站式解决方案，帮助中国企业高效开拓全球市场。
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="威拓星耀数据"
    stats={[
      { title: '服务企业', amount: '200+' },
      { title: '覆盖国家', amount: '30+' },
      { title: '服务语种', amount: '15+' },
      { title: '注册商标', amount: '150+' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="核心服务"
    subtitle="威拓星耀为外贸企业提供全链条品牌出海服务，覆盖从品牌策划到获客转化的每一个环节。"
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: '品牌独立站建设',
        description:
          '基于 Astro + Tailwind CSS 技术栈，打造高速、安全、多语言的品牌官网，Google PageSpeed 评分90+，完美适配移动端。',
        icon: 'tabler:template',
      },
      {
        title: 'GEO搜索引擎优化',
        description:
          '面向 ChatGPT、Perplexity 等 AI 搜索引擎的优化策略，让品牌信息在 AI 搜索结果中优先呈现，抢占流量新入口。',
        icon: 'tabler:template',
      },
      {
        title: '客户数据采集',
        description:
          '自建智能爬虫系统，精准采集全球 B2B 客户数据，覆盖公司、邮箱、电话、社媒等完整信息字段。',
        icon: 'tabler:template',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: '工具定制开发',
        description:
          '为企业量身打造自动化获客工具，包括数据采集、邮件营销、社交媒体自动开发等，提升客户开发效率300%。',
        icon: 'tabler:template',
      },
      {
        title: '品牌推广与商标',
        description:
          '提供 US 和 EU 国际商标注册、品牌代持、多语言品牌视觉体系设计等一站式品牌出海服务。',
        icon: 'tabler:template',
      },
      {
        title: '工作流自动化',
        description:
          '从询盘自动响应到客户分层管理、定时跟进，全链路自动化，构建24小时不间断的智能获客引擎。',
        icon: 'tabler:template',
      },
      {
        title: '方案定制咨询',
        description:
          '针对企业规模、行业特点和目标市场，提供一对一深度咨询，量身定制品牌出海综合方案。',
        icon: 'tabler:template',
      },
      {
        title: '持续运维支持',
        description:
          '网站维护、数据更新、策略优化，确保出海业务始终保持最佳状态，持续陪伴企业成长。',
        icon: 'tabler:template',
      },
      {
        title: '多语种内容创作',
        description:
          '专业母语写手团队，覆盖英语、德语、法语、日语、西班牙语等15+语种，地道内容助力本地化营销。',
        icon: 'tabler:template',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Colorful Image',
    }}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="企业价值观"
    subtitle="我们坚持用技术驱动和结果导向的理念，为每一家外贸企业提供真正有价值的出海服务。"
    items={[
      {
        title: '客户至上',
        description:
          '始终以客户需求为中心，深入了解每个行业和市场的特点，提供真正适合企业的定制化解决方案。',
      },
      {
        title: '持续创新',
        description:
          '紧跟技术发展趋势，不断迭代更新服务内容和工具产品，确保客户始终享受最前沿的出海解决方案。',
      },
      {
        title: '诚信专业',
        description:
          '以专业能力为基础，以诚信为准则，对每一个项目负责，让客户放心地把出海业务交给我们。',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="我们的成就"
    subtitle="经过多年的深耕和积累，威拓星耀已成功服务数百家外贸企业，足迹遍布全球主要市场。"
    isReversed={true}
    callToAction={{
      text: '了解更多',
      href: '/contact',
    }}
    items={[
      {
        title: '全球服务网络',
        description: '在中国、美国和欧盟均设有团队，无时差高效协作，确保本地化策略精准落地执行。',
        icon: 'tabler:globe',
      },
      {
        title: '客户高度评价',
        description:
          '多年累积的客户好评和推荐，见证了我们专业、负责的服务态度和切实可见的成效。',
        icon: 'tabler:message-star',
      },
      {
        title: '行业专业认可',
        description:
          '团队成员在外贸服务领域拥有10年以上经验，多次受邀参加行业峰会并分享出海经验。',
        icon: 'tabler:award',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="联系我们"
    tagline="联系方式"
    columns={4}
    items={[
      {
        title: '中国（总部）',
        description: '上海市浦东新区张江高科技园区',
      },
      {
        title: '美国',
        description: 'San Jose, California',
      },
      {
        title: '欧盟',
        description: 'Berlin, Germany',
      },
      {
        title: '在线服务',
        description: '支持全球远程咨询与服务交付',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="联系我们"
    tagline="沟通渠道"
    columns={2}
    items={[
      {
        title: '在线咨询',
        description:
          '通过网站表单或发送邮件至 info@vectoflare.com，我们将在24小时内回复您的咨询。',
        icon: 'tabler:messages',
      },
      {
        title: '电话联系',
        description:
          '致电 133-9532-1653，与我们的专业顾问一对一沟通您的出海需求。',
        icon: 'tabler:headset',
      },
    ]}
  />
</Layout>

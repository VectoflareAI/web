---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '服务项目',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="服务项目"
    title="全链条品牌出海解决方案"
    subtitle="从品牌独立站建设到GEO搜索引擎优化，从客户数据采集到自动化获客工具，威拓星耀为外贸企业提供一站式全球市场开发服务。"
    actions={[{ variant: 'primary', target: '_blank', text: '免费咨询', href: '/contact' }]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: '威拓星耀服务',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="核心服务体系"
    subtitle="六大服务模块，覆盖品牌出海全链路"
    columns={3}
    items={[
      {
        title: '品牌独立站建设',
        description:
          '基于 Astro + Tailwind CSS 技术栈，打造高速、安全、多语言的品牌官网，Google PageSpeed 评分90+，完美适配PC/平板/手机。',
        icon: 'tabler:school',
      },
      {
        title: 'GEO搜索引擎优化',
        description:
          '面向ChatGPT、Perplexity等AI搜索引擎的品牌优化策略，让您的品牌信息在AI搜索结果中被优先引用，抢占流量新入口。',
        icon: 'tabler:home-star',
      },
      {
        title: '客户数据库搭建',
        description:
          '自建智能爬虫系统，精准采集全球B2B客户信息，包含公司名、地址、联系人、邮箱、电话、社媒账号等全维度数据。',
        icon: 'tabler:photo',
      },
      {
        title: '自动化工具定制',
        description:
          '从数据采集到邮件营销，从社媒自动开发到CRM集成，为企业量身打造自动化获客工具链，提升客户开发效率300%。',
        icon: 'tabler:shopping-cart',
      },
      {
        title: '品牌推广与商标注册',
        description:
          '提供USPTO（美国）和EUIPO（欧盟）国际商标注册、品牌代持、多语言品牌视觉体系设计等一站式品牌出海服务。',
        icon: 'tabler:article',
      },
      {
        title: '工作流自动化',
        description:
          '打通从询盘自动响应、客户分层管理到定时跟进的全链路自动化流程，构建24小时不间断的智能获客引擎。',
        icon: 'tabler:building-store',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: '技术驱动',
        description:
          '采用最新的Web技术和AI算法，确保您的品牌在技术和营销层面都保持行业领先。',
        icon: 'tabler:wand',
      },
      {
        title: '数据导向',
        description:
          '所有策略和决策均基于真实市场数据，确保营销投入的精准高效。',
        icon: 'tabler:settings',
      },
      {
        title: '本地化执行',
        description:
          '中美欧三地团队协同，确保每个目标市场的品牌策略都能精准落地。',
        icon: 'tabler:presentation',
      },
      {
        title: '长期陪伴',
        description:
          '不只是项目交付，更提供持续的运维支持和策略优化，伴随企业全球化成长。',
        icon: 'tabler:carousel-horizontal',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1525909002-1b05e0c869d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80',
      alt: '服务优势',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">为什么选择威拓星耀？</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: '10年+行业经验',
        description:
          '深耕外贸服务领域多年，深刻理解B2B出海各环节痛点与解决方案。',
        icon: 'tabler:clock',
      },
      {
        title: '200+成功案例',
        description:
          '累计服务超过200家外贸企业，覆盖机械、电子、化工、消费品等多个行业。',
        icon: 'tabler:school',
      },
      {
        title: '全链条服务',
        description:
          '从品牌策划到获客转化，提供完整的业务增长闭环，客户无需对接多个服务商。',
        icon: 'tabler:coin',
      },
      {
        title: '结果导向',
        description:
          '以实际效果为衡量标准，定期提供数据报告，确保每一分投入都有回报。',
        icon: 'tabler:file-download',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664688-cf412ec27db2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: '为什么选择我们',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">我们的优势</h3>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="客户评价"
    testimonials={[
      {
        testimonial: `威拓星耀帮助我们搭建了全新的英文品牌官网，GEO优化后公司在ChatGPT搜索中的提及率明显提升，已经接到了多个来自北美的新客户询盘。`,
        name: '张先生',
        job: '某机械设备出口企业 总经理',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: '客户评价',
        },
      },
      {
        testimonial: `客户数据采集服务非常专业，数据质量很高。结合他们定制的邮件营销工具，我们的客户开发效率提升了至少3倍。`,
        name: '李女士',
        job: '某电子产品外贸公司 市场总监',
        image: {
          src: 'https://images.unsplash.com/photo-1561406636-b80293969660?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: '客户评价',
        },
      },
      {
        testimonial: `从品牌策划到美国商标注册，再到网站建设和GEO优化，威拓星耀提供了完整的出海解决方案。他们的专业和负责让我们非常放心。`,
        name: '王总',
        job: '某化工企业 创始人',
        image: {
          src: 'https://images.unsplash.com/photo-1545167622-3a6ac756afa4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=824&q=80',
          alt: '客户评价',
        },
      },
    ]}
    callToAction={{
      target: '_blank',
      text: '查看更多案例...',
      href: '/contact',
      icon: 'tabler:chevron-right',
    }}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '免费咨询',
        href: '/contact',
      },
    ]}
    title="开启您的全球市场之旅"
    subtitle="立即联系威拓星耀，获取专属品牌出海方案。"
  />
</Layout>

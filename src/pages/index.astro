---
import Layout from '~/layouts/PageLayout.astro';

import HeroSlider from '~/components/widgets/HeroSlider.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '威拓星耀 — 全球市场开发方案集成商',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- 首页轮播图组件 — 取代原有单张 Hero 图片，3 张照片自动轮播展示品牌形象、工业制造、全球商务 -->

  <HeroSlider
    actions={[
      {
        variant: 'primary',
        text: '建站模板',
        href: 'https://github.com/VectoflareAI/web',
        target: '_blank',
        icon: 'tabler:download',
      },
      { text: '了解更多', href: '#features' },
    ]}
    images={[
      /* 轮播图 第1张：品牌形象照片（网页左上角突出位置） */
      { src: '~/assets/images/hero-image.png', alt: '威拓星耀 品牌形象' },
      /* 轮播图 第2张：工业制造/产品场景照片（页面中部区域） */
      { src: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=1200&q=80', alt: '工业制造场景' },
      /* 轮播图 第3张：全球商务/市场拓展照片（页面右下区域） */
      { src: 'https://images.unsplash.com/photo-1521791136064-7986c2920216?w=1200&q=80', alt: '全球商务市场' },
    ]}
  >
    <Fragment slot="title">
      搭建AI运行环境， <span class="hidden xl:inline">工作流程自动化</span>
      <span class="text-accent dark:text-white"> 全面优化客户大数据库</span> + 优化品牌形象
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">威拓星耀</span> 是一家品牌本地化部署方案的集成商。</span
      >
      携手威拓星耀，助您快速打通全球市场，让您的产品和服务以新的品牌形象进入目标市场线下零售渠道。
    </Fragment>
  </HeroSlider>

  <!-- Note Widget ******************* -->

  <Note title="宗旨:" description="搭建AI运行环境，工作流程自动化, 品牌推广全面化，实现利益最大化" />

  <!-- Features Widget *************** -->

  <Features
    id="品牌故事"
    tagline="品牌故事"
    title="威拓星耀的诞生"
    subtitle="在外贸品牌出海的征途中，我们见过太多遗憾。 很多公司拥有极高质量的产品，却因为缺乏市场开发的效率，在茫茫商海中默默无闻；而另一部分公司盲目追求速度，乱发邮件、乱投广告，却因为缺乏精准的筛选，导致转化寥寥。."
    items={[
      {
        title: '外贸独立站建设',
        description:
          '基于 Astro + Tailwind CSS 技术栈打造高速、安全、SEO友好的多语言品牌独立站，适配PC/平板/手机，Google PageSpeed 评分90+。',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'GEO搜索引擎优化',
        description:
          '针对AI生成式搜索引擎（ChatGPT、Perplexity等）的优化策略，让您的品牌信息在AI搜索结果中被优先引用，抢占流量新入口。',
        icon: 'tabler:components',
      },
      {
        title: '客户数据库搭建',
        description:
          '智能数据采集系统，每小时采集数千条精准客户数据，覆盖全球主要B2B平台和社交网络，自动验证邮箱有效性。',
        icon: 'tabler:list-check',
      },
      {
        title: '外贸工具定制开发',
        description:
          '从Facebook/Google Maps数据采集到Email防封群发，为企业量身打造自动化获客工具，提升客户开发效率300%。',
        icon: 'tabler:rocket',
      },
      {
        title: '品牌推广与商标注册',
        description:
          '提供国际商标注册（美国USPTO/欧盟EUIPO）、品牌代持、多语言品牌视觉建设等一站式品牌出海服务。',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: '工作流自动化',
        description:
          '打通从询盘自动响应、客户分层管理到定时跟进的全链路自动化流程，构建24小时不间断的智能获客引擎。',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="核心优势"
    title="为什么选择威拓星耀？"
    items={[
      {
        title: '10年+出海行业经验',
        description:
          '深耕外贸服务领域十年，累计服务超过200家企业，深刻理解B2B出海各环节痛点与解决方案。',
      },
      {
        title: '全链条一站式服务',
        description:
          '从品牌策划、网站建设、GEO优化到客户数据采集和工具定制，提供完整的业务增长闭环。',
      },
      {
        title: '中美欧本地化团队',
        description:
          '在中国、美国和欧盟均有专业团队，无时差高效协作，确保本地化策略精准落地。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: '威拓星耀团队',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">专业团队，值得信赖</h3>
      威拓星耀以技术驱动和结果导向为核心理念，为每一家外贸企业提供量身定制的全球市场开发方案。
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: '定制化服务',
        description: '根据企业规模、行业特点和目标市场，量身打造专属方案，拒绝千篇一律的模板化服务。',
      },
      {
        title: '数据驱动决策',
        description: '基于市场数据分析制定策略，每个决策都有数据支撑，确保营销投入的精准高效。',
      },
      {
        title: '多语言内容能力',
        description: '支持英语、德语、法语、日语、西班牙语等15+语种的专业内容创作，真正实现全球化沟通。',
      },
      {
        title: '持续优化迭代',
        description: '服务不是终点而是起点。我们提供持续的监测、优化和迭代，确保策略始终与市场同步。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: '解决方案示意图',
    }}
  >
    <Fragment slot="content">让专业的人做专业的事，威拓星耀助您在全球市场闪耀。</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: '品牌定位与策略',
        description:
          '深度调研目标市场与竞品，明确品牌差异化定位，制定完整的本地化品牌出海策略。',
      },
      {
        title: '技术与工具赋能',
        description:
          '利用AI和大数据技术打造智能获客工具，让技术成为业务增长的核心驱动力。',
      },
      {
        title: '效率最大化',
        description:
          '通过工作流自动化和智能工具，将重复性工作交给系统，让团队专注于高价值的业务决策。',
      },
      {
        title: '持续陪伴成长',
        description: '威拓星耀不只是服务商，更是您的长期合作伙伴，伴随企业从初创到全球品牌的每一步成长。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: '全球市场拓展',
    }}
  >
    <Fragment slot="content">承载中国制造，传递全球价值。</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="威拓星耀合作流程 — 四步开启全球市场"
    items={[
      {
        title: '第一步：<span class="font-medium">需求诊断</span>',
        description:
          '深入了解您的行业、目标和痛点。我们通过结构化访谈和数据分析，精准定位您的核心需求，输出详细的需求诊断报告。',
        icon: 'tabler:package',
      },
      {
        title: '第二步：<span class="font-medium">方案定制</span>',
        description:
          '基于诊断结果，为您量身定制包含网站建设、GEO优化、数据采集、工具开发等在内的综合解决方案，并明确交付标准和时间节点。',
        icon: 'tabler:letter-case',
      },
      {
        title: '第三步：<span class="font-medium">执行落地</span>',
        description:
          '由专业团队按计划执行，定期汇报进展。每个环节都有明确的质量标准和验收流程，确保交付品质。',
        icon: 'tabler:paint',
      },
      {
        title: '第四步：<span class="font-medium">持续优化</span>',
        icon: 'tabler:check',
        description:
          '服务交付不是终点。我们将持续监测效果数据，定期提供优化建议，确保您的业务始终保持增长态势。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: '合作流程',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="服务项目总览"
    subtitle="威拓星耀为外贸企业提供六大核心服务模块，覆盖品牌出海全链路。"
    tagline="服务模块"
    items={[
      {
        title: '品牌独立站建设',
        description: '多语言、高速、SEO友好的外贸品牌网站，支持中/英/日/德/法等15+语种。',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'GEO搜索优化',
        description: '面向AI搜索引擎的品牌优化策略，让您的品牌在ChatGPT等平台中成为推荐答案。',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: '客户数据采集',
        description: '智能爬虫系统精准采集全球B2B客户数据，包含公司、邮箱、电话、社交媒体等完整字段。',
        icon: 'flat-color-icons:approval',
      },
      {
        title: '自动化工具定制',
        description: '根据业务需求定制开发数据采集、邮件营销、客户管理等自动化工具。',
        icon: 'flat-color-icons:document',
      },
      {
        title: '品牌推广与商标',
        description: 'USPTO/EUIPO商标注册、品牌代持、多语言品牌视觉体系设计。',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: '工作流自动化',
        description: '从询盘响应到客户跟进的全流程自动化，打造24小时智能获客引擎。',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: '方案定制咨询',
        description: '根据企业规模、行业和目标市场，提供一对一的专业咨询与方案设计。',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: '持续运维支持',
        description: '网站维护、数据更新、策略优化，确保您的出海业务始终保持最佳状态。',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: '多语种内容创作',
        description: '专业母语写手团队，为每个目标市场创作地道的营销内容。',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="最新资讯与行业洞察"
    information={`了解威拓星耀的最新动态，获取品牌出海、GEO优化、外贸获客等领域的专业知识和实战经验分享。`}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="常见问题"
    subtitle="关于威拓星耀的服务，您可能想了解以下问题。"
    tagline="FAQ"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '威拓星耀与其他建站/营销公司有什么不同？',
        description:
          '我们不只是建站公司，更是全球市场开发方案集成商。从网站建设到GEO优化，从数据采集到工具定制，从品牌推广到商标注册，我们提供的是全链条一站式解决方案，而非单一服务。',
      },
      {
        title: '我没有技术背景，能使用你们的服务吗？',
        description:
          '完全可以。我们提供的是交钥匙服务，您只需提供业务需求，从方案设计到执行落地全程由我们专业团队完成。您只需要专注于自己的核心业务。',
      },
      {
        title: '你们的服务周期一般是多久？',
        description:
          '基础网站建设约2-4周，完整的品牌出海方案（含网站+GEO+数据采集）约4-8周。具体周期根据项目复杂度而定。',
      },
      {
        title: 'GEO优化真的有效吗？',
        description:
          '随着ChatGPT、Perplexity等AI搜索引擎的普及，GEO已经成为品牌获取新流量的重要渠道。我们的客户在实施GEO优化后，品牌在AI搜索结果中的引用率平均提升200%以上。',
      },
      {
        title: '国际商标注册需要多长时间？',
        description:
          '美国商标（USPTO）通常需要8-12个月，欧盟商标（EUIPO）通常需要4-6个月。我们会全程跟进，包括审查意见答复等复杂环节，确保注册顺利进行。',
      },
      {
        title: '如果我后续需要调整服务内容怎么办？',
        description:
          '我们提供灵活的按需服务模式。您可以随时根据业务发展需要调整服务内容，我们会有专属客户经理为您协调安排。',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: '服务企业', amount: '200+' },
      { title: '覆盖国家', amount: '30+' },
      { title: '服务语种', amount: '15+' },
      { title: '商标成功注册', amount: '150+' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '免费咨询',
        href: '/contact',
        icon: 'tabler:message',
      },
    ]}
  >
    <Fragment slot="title">
      准备好开启<span class="sm:whitespace-nowrap">全球市场之旅</span>了吗？
    </Fragment>

    <Fragment slot="subtitle">
      立即联系威拓星耀，获取专属品牌出海方案。 <br class="hidden md:inline" />首次咨询免费！
    </Fragment>
  </CallToAction>
</Layout>

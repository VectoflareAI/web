---
import Layout from '~/layouts/PageLayout.astro';

const socials = [
  {
    name: '微信视频号',
    url: 'https://weixin.qq.com/cgi-bin/readtemplate?action=gotohome&t=weixin&lang=zh_CN',
    icon: 'tabler:brand-wechat',
    desc: '关注我们的视频号，获取最新产品演示与技术分享',
    color: '#07C160',
  },
  {
    name: '抖音',
    url: 'https://www.douyin.com/user/',
    icon: 'tabler:brand-tiktok',
    desc: '关注抖音账号，观看产品加工与工艺展示视频',
    color: '#000000',
  },
  {
    name: '小红书',
    url: 'https://www.xiaohongshu.com/user/',
    icon: 'tabler:brand-reddit',
    desc: '关注小红书账号，获取行业资讯与应用案例',
    color: '#FF2442',
  },
];

const metadata = {
  title: '社交媒体',
};
---

<Layout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">社交媒体</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        关注我们的社交平台，获取最新产品资讯、技术分享与应用案例
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {socials.map(s => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group block p-8 rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
        >
          <div
            class="w-16 h-16 rounded-2xl flex items-center justify-center mb-5 mx-auto transition-transform group-hover:scale-110"
            style={`background-color: ${s.color}20`}
          >
            <svg class="w-8 h-8" style={`color: ${s.color}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-center text-gray-900 dark:text-white mb-2">{s.name}</h2>
          <p class="text-sm text-center text-gray-500 dark:text-gray-400">{s.desc}</p>
          <div class="mt-4 text-center">
            <span
              class="inline-flex items-center gap-1 text-sm font-medium"
              style={`color: ${s.color}`}
            >
              前往关注
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
---
/**
 * 首页轮播图组件
 * 每张轮播图上叠加可编辑的文字内容，半透明渐变背景确保文字清晰
 */
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  actions = await Astro.slots.render('actions'),
  images = [],
  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<section class="relative md:-mt-[76px] not-prose" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-12 md:py-20">
      <!-- 轮播图容器 -->
      <div
        class="relative m-auto max-w-5xl intersect-once intersect-no-queue intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
        id="hero-carousel"
      >
        <div class="overflow-hidden rounded-md">
          <div id="carousel-track" class="flex transition-transform duration-700 ease-in-out">
            <!-- 轮播图 第1张：品牌形象照片，文字叠加在图片上方 -->
            <div class="min-w-full relative">
              {
                images[0] && (
                  <Image
                    class="mx-auto w-full"
                    widths={[400, 768, 1024, 2040]}
                    sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                    loading="eager"
                    fetchpriority="high"
                    width={1024}
                    height={576}
                    format="webp"
                    {...images[0]}
                  />
                )
              }
              <!-- 半透明渐变遮罩，确保文字在任何底色上都清晰可见 -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent rounded-md"></div>
              <!-- 叠加文字内容 -->
              <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10 text-center">
                {
                  title && (
                    <h1
                      class="text-white text-3xl md:text-4xl font-bold leading-tight mb-3 drop-shadow-lg"
                      set:html={title}
                    />
                  )
                }
                {
                  subtitle && (
                    <p
                      class="text-white/90 text-base md:text-lg max-w-2xl mx-auto mb-4 drop-shadow"
                      set:html={subtitle}
                    />
                  )
                }
                {
                  actions && (
                    <div class="flex flex-wrap justify-center gap-3">
                      {Array.isArray(actions) ? (
                        actions.map((action) => <Button {...(action || {})} class="!shadow-lg" />)
                      ) : (
                        <Fragment set:html={actions} />
                      )}
                    </div>
                  )
                }
              </div>
            </div>
            <!-- 轮播图 第2张：工业制造/产品场景照片，文字叠加在图片上方 -->
            <div class="min-w-full relative">
              {
                images[1] && (
                  <Image
                    class="mx-auto w-full"
                    widths={[400, 768, 1024, 2040]}
                    sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                    loading="eager"
                    fetchpriority="high"
                    width={1024}
                    height={576}
                    format="webp"
                    {...images[1]}
                  />
                )
              }
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent rounded-md"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10 text-center">
                {
                  title && (
                    <h1
                      class="text-white text-3xl md:text-4xl font-bold leading-tight mb-3 drop-shadow-lg"
                      set:html={title}
                    />
                  )
                }
                {
                  subtitle && (
                    <p
                      class="text-white/90 text-base md:text-lg max-w-2xl mx-auto mb-4 drop-shadow"
                      set:html={subtitle}
                    />
                  )
                }
                {
                  actions && (
                    <div class="flex flex-wrap justify-center gap-3">
                      {Array.isArray(actions) ? (
                        actions.map((action) => <Button {...(action || {})} class="!shadow-lg" />)
                      ) : (
                        <Fragment set:html={actions} />
                      )}
                    </div>
                  )
                }
              </div>
            </div>
            <!-- 轮播图 第3张：全球商务/市场拓展照片，文字叠加在图片上方 -->
            <div class="min-w-full relative">
              {
                images[2] && (
                  <Image
                    class="mx-auto w-full"
                    widths={[400, 768, 1024, 2040]}
                    sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                    loading="eager"
                    fetchpriority="high"
                    width={1024}
                    height={576}
                    format="webp"
                    {...images[2]}
                  />
                )
              }
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent rounded-md"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10 text-center">
                {
                  title && (
                    <h1
                      class="text-white text-3xl md:text-4xl font-bold leading-tight mb-3 drop-shadow-lg"
                      set:html={title}
                    />
                  )
                }
                {
                  subtitle && (
                    <p
                      class="text-white/90 text-base md:text-lg max-w-2xl mx-auto mb-4 drop-shadow"
                      set:html={subtitle}
                    />
                  )
                }
                {
                  actions && (
                    <div class="flex flex-wrap justify-center gap-3">
                      {Array.isArray(actions) ? (
                        actions.map((action) => <Button {...(action || {})} class="!shadow-lg" />)
                      ) : (
                        <Fragment set:html={actions} />
                      )}
                    </div>
                  )
                }
              </div>
            </div>
          </div>
        </div>

        <!-- 轮播导航圆点 -->
        <div class="flex justify-center gap-3 mt-6" id="carousel-dots">
          <button
            data-slide="0"
            class="w-3 h-3 rounded-full bg-primary/80 hover:bg-primary transition-colors"
            aria-label="切换到第1张"></button>
          <button
            data-slide="1"
            class="w-3 h-3 rounded-full bg-gray-300 hover:bg-primary/60 transition-colors"
            aria-label="切换到第2张"></button>
          <button
            data-slide="2"
            class="w-3 h-3 rounded-full bg-gray-300 hover:bg-primary/60 transition-colors"
            aria-label="切换到第3张"></button>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const track = /** @type {HTMLElement} */ (document.getElementById('carousel-track'));
    const dots = document.querySelectorAll('#carousel-dots button');
    if (!dots.length) return;

    let current = 0;
    const total = dots.length;
    let interval = null;

    function goTo(index) {
      if (index < 0 || index >= total) return;
      current = index;
      track.style.transform = 'translateX(-' + current * 100 + '%)';
      dots.forEach(function (dot, i) {
        if (i === current) {
          dot.className = 'w-3 h-3 rounded-full bg-primary/80 hover:bg-primary transition-colors';
        } else {
          dot.className = 'w-3 h-3 rounded-full bg-gray-300 hover:bg-primary/60 transition-colors';
        }
      });
    }

    function startAutoPlay() {
      stopAutoPlay();
      interval = setInterval(function () {
        goTo((current + 1) % total);
      }, 5000);
    }

    function stopAutoPlay() {
      if (interval !== null) {
        clearInterval(interval);
        interval = null;
      }
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        const idx = parseInt(dot.getAttribute('data-slide') || '0', 10);
        goTo(idx);
        startAutoPlay();
      });
    });

    const carousel = document.getElementById('hero-carousel');
    if (carousel) {
      carousel.addEventListener('mouseenter', stopAutoPlay);
      carousel.addEventListener('mouseleave', startAutoPlay);
    }

    startAutoPlay();
  })();
</script>

---
/**
 * 全站搜索对话框
 * 点击搜索图标后弹出白色对话框，支持按页面标题和描述模糊搜索
 */
export interface Props {
  iconClass?: string;
}

const { iconClass = 'w-5 h-5' } = Astro.props;
---

<button
  type="button"
  id="search-toggle"
  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
  aria-label="搜索全站内容"
>
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
  </svg>
</button>

<!-- 搜索遮罩层 -->
<div
  id="search-overlay"
  class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-sm"
>
  <!-- 搜索对话框（白底） -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[90vw] max-w-2xl max-h-[80vh] bg-white dark:bg-gray-800 rounded-2xl shadow-2xl flex flex-col"
  >
    <!-- 搜索输入框 -->
    <div class="flex items-center gap-3 px-5 py-4 border-b border-gray-200 dark:border-gray-700">
      <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
      </svg>
      <input
        id="search-input"
        type="text"
        class="w-full bg-transparent border-none outline-none text-gray-900 dark:text-gray-100 placeholder-gray-400 text-lg"
        placeholder="搜索页面标题..."
        autofocus
        autocomplete="off"
      />
      <kbd class="hidden sm:inline-flex items-center px-2 py-1 text-xs text-gray-400 bg-gray-100 dark:bg-gray-700 dark:text-gray-300 rounded">ESC</kbd>
    </div>

    <!-- 搜索结果 -->
    <div
      id="search-results"
      class="overflow-y-auto p-2 flex-1 min-h-0"
    >
      <div id="search-empty" class="hidden text-center py-12 text-gray-400 dark:text-gray-500">
        <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-sm">未找到匹配页面</p>
      </div>
      <div id="search-hint" class="text-center py-12 text-gray-400 dark:text-gray-500">
        <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
        </svg>
        <p class="text-sm">输入关键词搜索页面</p>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    /* 全站搜索数据 */
    var pages = [
      { url: '/', title: '首页', desc: '威拓星耀 — 全球市场开发方案集成商' },
      { url: '/about', title: '关于我们', desc: '了解威拓星耀' },
      { url: '/services', title: '服务', desc: '产品与服务' },
      { url: '/r-d-center', title: '研发中心', desc: '持续创新，驱动未来' },
      { url: '/service-center', title: '技术中心', desc: '技术赋能，服务全球' },
      { url: '/products', title: '全部产品', desc: '浏览全部产品分类' },
      { url: '/products/graphite-molds', title: '石墨模具', desc: '石墨模具产品系列' },
      { url: '/products/graphite-products', title: '石墨制品', desc: '石墨制品产品系列' },
      { url: '/products/graphite-molds/graphite-mold', title: '石墨模具 — 石墨模具', desc: '高纯石墨模具产品详情' },
      { url: '/products/graphite-molds/graphite-crucible', title: '石墨模具 — 石墨坩埚', desc: '石墨坩埚产品详情' },
      { url: '/products/graphite-products/hard-composite-graphite-felt', title: '石墨制品 — 硬质复合石墨毡', desc: '硬质复合石墨毡产品详情' },
      { url: '/products/graphite-products/graphite-felt-rayon', title: '石墨制品 — 石墨毡（粘胶基）', desc: '石墨毡粘胶基产品详情' },
      { url: '/workflow', title: '工作流定制', desc: '工作流程自动化方案' },
      { url: '/tools', title: '专业工具定制', desc: '专业工具定制服务' },
      { url: '/pricing', title: '定价', desc: '产品与服务定价' },
      { url: '/terms', title: '服务条款', desc: '服务条款与条件' },
      { url: '/privacy', title: '隐私政策', desc: '隐私保护政策' },
      { url: '/contact', title: '联系我们', desc: '联系威拓星耀' },
      { url: '/blog', title: '博客', desc: '最新文章与资讯' },
    ];

    var toggle = document.getElementById('search-toggle');
    var overlay = document.getElementById('search-overlay');
    var input = document.getElementById('search-input');
    var results = document.getElementById('search-results');
    var empty = document.getElementById('search-empty');
    var hint = document.getElementById('search-hint');

    if (!toggle || !overlay || !input || !results || !empty || !hint) return;

    function open() {
      overlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(function () { input.focus(); }, 100);
    }

    function close() {
      overlay.classList.add('hidden');
      document.body.style.overflow = '';
      input.value = '';
      hint.classList.remove('hidden');
      empty.classList.add('hidden');
      results.querySelectorAll('.search-result-item').forEach(function (el) { el.remove(); });
    }

    function search(query) {
      var q = query.toLowerCase().trim();
      results.querySelectorAll('.search-result-item').forEach(function (el) { el.remove(); });
      hint.classList.add('hidden');
      empty.classList.add('hidden');

      if (!q) {
        hint.classList.remove('hidden');
        return;
      }

      var matches = pages.filter(function (p) {
        return p.title.toLowerCase().indexOf(q) !== -1 || p.desc.toLowerCase().indexOf(q) !== -1;
      });

      if (matches.length === 0) {
        empty.classList.remove('hidden');
        return;
      }

      matches.forEach(function (p) {
        var a = document.createElement('a');
        a.href = p.url;
        a.className = 'search-result-item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors';
        a.innerHTML =
          '<svg class="w-4 h-4 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>' +
          '<div class="flex-1 min-w-0"><div class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate">' + p.title + '</div><div class="text-xs text-gray-500 dark:text-gray-400 truncate">' + p.desc + '</div></div>';
        results.appendChild(a);
      });
    }

    toggle.addEventListener('click', open);

    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) close();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); open(); }
    });

    var debounceTimer;
    input.addEventListener('input', function () {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function () { search(input.value); }, 150);
    });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });
  })();
</script>
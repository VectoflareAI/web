---
export interface Props {
  iconClass?: string;
}

const { iconClass = 'w-5 h-5' } = Astro.props;
---

<button
  type="button"
  id="search-toggle"
  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
  aria-label="搜索全站内容"
>
  <svg class={iconClass} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"></path>
  </svg>
</button>

<div id="search-overlay" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm" style="display:none">
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[90vw] max-w-2xl max-h-[80vh] bg-white dark:bg-gray-800 rounded-2xl shadow-2xl flex flex-col"
  >
    <div class="flex items-center gap-3 px-5 py-4 border-b border-gray-200 dark:border-gray-700">
      <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
      </svg>
      <input
        id="search-input"
        type="text"
        class="w-full bg-transparent border-none outline-none text-gray-900 dark:text-gray-100 placeholder-gray-400 text-lg"
        placeholder="搜索页面标题..."
        autofocus
        autocomplete="off"
      />
      <button
        id="search-submit"
        type="button"
        class="p-1.5 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700"
        aria-label="执行搜索"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
        </svg>
      </button>
      <kbd class="hidden sm:inline-flex items-center px-2 py-1 text-xs text-gray-400 bg-gray-100 dark:bg-gray-700 dark:text-gray-300 rounded">ESC</kbd>
    </div>
    <div id="search-results" class="overflow-y-auto p-2 flex-1 min-h-0">
      <div id="search-empty" class="text-center py-12 text-gray-400 dark:text-gray-500" style="display:none">
        <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-sm">未找到匹配页面</p>
      </div>
      <div id="search-hint" class="text-center py-12 text-gray-400 dark:text-gray-500">
        <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
        </svg>
        <p class="text-sm">输入关键词搜索页面</p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var pages = [
      { url: '/', title: '首页', desc: '威拓星耀 — 全球市场开发方案集成商' },
      { url: '/about', title: '关于我们', desc: '了解威拓星耀' },
      { url: '/brand-service', title: '品牌推广', desc: '品牌出海推广与商标注册服务' },
      { url: '/services', title: '服务', desc: '产品与服务' },
      { url: '/r-d-center', title: '研发中心', desc: '持续创新，驱动未来' },
      { url: '/service-center', title: '技术支持', desc: '技术赋能，服务全球' },
      { url: '/products', title: '全部产品', desc: '浏览全部产品分类' },
      { url: '/workflow', title: '工作流定制', desc: '工作流程自动化方案' },
      { url: '/tools', title: '专业工具定制', desc: '专业工具定制服务' },
      { url: '/pricing', title: '定价', desc: '产品与服务定价' },
      { url: '/terms', title: '服务条款', desc: '服务条款与条件' },
      { url: '/privacy', title: '隐私政策', desc: '隐私保护政策' },
      { url: '/contact', title: '联系我们', desc: '联系威拓星耀' },
      { url: '/news', title: '新闻', desc: '最新新闻与资讯' },
    ];

    var LISTENERS_ATTACHED = false;

    function get(id) {
      return document.getElementById(id);
    }

    function openOverlay() {
      var overlay = get('search-overlay');
      var input = get('search-input');
      if (!overlay || !input) return;
      overlay.style.display = '';
      document.body.style.overflow = 'hidden';
      setTimeout(function () {
        input.focus();
      }, 100);
    }

    function closeOverlay() {
      var overlay = get('search-overlay');
      var input = get('search-input');
      var hint = get('search-hint');
      var empty = get('search-empty');
      var results = get('search-results');
      if (!overlay || !input) return;
      overlay.style.display = 'none';
      document.body.style.overflow = '';
      input.value = '';
      if (hint) hint.style.display = '';
      if (empty) empty.style.display = 'none';
      if (results) {
        results.querySelectorAll('.search-result-item').forEach(function (el) {
          el.remove();
        });
      }
    }

    function doSearch(query) {
      var results = get('search-results');
      var hint = get('search-hint');
      var empty = get('search-empty');
      if (!results || !hint || !empty) return;

      var q = query.toLowerCase().trim();
      results.querySelectorAll('.search-result-item').forEach(function (el) {
        el.remove();
      });
      hint.style.display = 'none';
      empty.style.display = 'none';

      if (!q) {
        hint.style.display = '';
        return;
      }

      var matches = pages.filter(function (p) {
        return p.title.toLowerCase().indexOf(q) !== -1 || p.desc.toLowerCase().indexOf(q) !== -1;
      });

      if (matches.length === 0) {
        empty.style.display = '';
        return;
      }

      matches.forEach(function (p) {
        var a = document.createElement('a');
        a.href = p.url;
        a.className = 'search-result-item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors';
        a.innerHTML =
          '<svg class="w-4 h-4 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>' +
          '<div class="flex-1 min-w-0"><div class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate">' +
          p.title +
          '</div><div class="text-xs text-gray-500 dark:text-gray-400 truncate">' +
          p.desc +
          '</div></div>';
        results.appendChild(a);
      });

      var viewAll = document.createElement('a');
      viewAll.href = '/search?q=' + encodeURIComponent(query);
      viewAll.className = 'search-result-item flex items-center justify-center gap-2 px-4 py-3 mt-1 rounded-xl text-sm text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/30 transition-colors font-medium';
      viewAll.innerHTML = '查看全部 ' + matches.length + ' 个结果 <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>';
      results.appendChild(viewAll);
    }

    function executeSearch() {
      var input = get('search-input');
      if (!input) return;
      var q = input.value.trim();
      if (q) {
        window.location.href = '/search?q=' + encodeURIComponent(q);
      }
    }

    function attachListeners() {
      if (LISTENERS_ATTACHED) return;
      LISTENERS_ATTACHED = true;

      document.addEventListener('click', function (e) {
        var toggle = get('search-toggle');
        var overlay = get('search-overlay');
        var submitBtn = get('search-submit');

        if (toggle && toggle.contains(e.target)) {
          openOverlay();
          return;
        }
        if (overlay && e.target === overlay) {
          closeOverlay();
          return;
        }
        if (submitBtn && submitBtn.contains(e.target)) {
          executeSearch();
          return;
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          closeOverlay();
        }
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          openOverlay();
        }
      });

      document.addEventListener('input', function (e) {
        var input = get('search-input');
        if (input && e.target === input) {
          doSearch(input.value);
        }
      });

      document.addEventListener('keydown', function (e) {
        var input = get('search-input');
        if (input && e.target === input && e.key === 'Enter') {
          e.preventDefault();
          executeSearch();
        }
      });
    }

    attachListeners();
    document.addEventListener('astro:page-load', attachListeners);
  })();
</script>

---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '产品中心 — VectoflareAI',
  description: '探索 VectoflareAI 旗下的高能核心产品与创新解决方案。',
};
---

<Layout metadata={metadata}>
  <!-- 1. 产品页大横幅 (Hero) -->
  <Hero
    tagline="产品中心"
    title="卓越效能，触手可及"
    subtitle="我们专注于提供下一代 AI 视觉与高科技软硬件集成，赋能您的每一个创新业务场景。"
    actions={[{ variant: 'primary', text: '在线询盘', href: '#contact' }]}
  />

  <!-- 2. 产品核心大类展示 (Features3) -->
  <Features3
    title="核心产品矩阵"
    subtitle="多维度的技术生态，满足不同行业的高端需求"
    columns={3}
    items={[
      {
        title: 'Vectoflare AI 核心系统',
        description: '高精度的图像与视觉生成加速引擎，支持工业级大规模部署。',
        icon: 'tabler:cpu',
      },
      {
        title: '智能控制终端',
        description: '无缝集成软硬件，提供全自动化的网络路由加密与边缘计算算力。',
        icon: 'tabler:device-laptop',
      },
      {
        title: '专业定制方案 (OEM/ODM)',
        description: '提供私有化标签、独立品牌视觉与全套技术标准输出。',
        icon: 'tabler:palette',
      },
    ]}
  />

  <!-- 3. 产品详细参数/技术优势对照 (Features2) -->
  <Features2
    title="硬核技术指标"
    subtitle="用数字化标准诠释品牌含金量"
    columns={2}
    items={[
      {
        title: '全球边缘节点加速',
        description: '基于 Cloudflare 全球网络架构，确保数据传输和响应低于 50ms。',
        icon: 'tabler:rocket',
      },
      {
        title: '工业级安全架构',
        description: '内置高强度数据加密与多层安全防护认证，坚如磐石。',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <!-- 4. 页尾转化按钮 (CTA) -->
  <CallToAction
    actions={[{ variant: 'primary', text: '联系我们', href: 'mailto:contact@vectoflare.com' }]}
    title="准备好升级您的体验了吗？"
    subtitle="立即联系我们的市场开发经理，获取个性化定制的产品技术规格书与商务报价。"
  />
</Layout>
